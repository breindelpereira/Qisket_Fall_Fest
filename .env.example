# Copy this file to .env.local (which git ignores) and fill it in. Only values that are safe to ship go here:
# anything starting with VITE_ is copied into the app, so NEVER put the Gemini API key in this file.

# Address of the deployed AI Tutor function (see worker/README.md), for example
#   https://qisket-tutor.your-name.workers.dev/api/tutor
# Leave empty to run the tutor offline only: it then answers from the notes on the device.
VITE_TUTOR_URL=
